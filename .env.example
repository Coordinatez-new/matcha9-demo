# Copy to .env.local for local development (`cp .env.example .env.local`).
# On a host, set the same variables in its dashboard.

# ── Dashboard sign-in (/admin) ─────────────────────────────────────────────
# Demo credentials for local use. Choose your own before the site is shared.
ADMIN_EMAIL=owner@matcha9.test
ADMIN_PASSWORD=whisk-slowly-2026

# ── Database ───────────────────────────────────────────────────────────────
# Any Postgres (Neon, Supabase, Railway, RDS…). Leave unset to use the embedded Postgres,
# stored in ./.data/pglite (or PGLITE_DIR). The embedded one needs a persistent disk.
# DATABASE_URL=postgres://user:password@host:5432/matcha9
# PGLITE_DIR=/data/pglite

# ── Site URL ───────────────────────────────────────────────────────────────
# Public address, used for share images. Vercel and Railway URLs are detected automatically.
# NEXT_PUBLIC_SITE_URL=https://www.sipmatcha9.com

# ── Toast POS (optional) ───────────────────────────────────────────────────
# With all five set, website orders are also sent to Toast. Needs a Toast integration with
# order-write access; test against the sandbox host first.
# TOAST_API_HOST=https://ws-sandbox-api.eng.toasttab.com
# TOAST_CLIENT_ID=
# TOAST_CLIENT_SECRET=
# TOAST_RESTAURANT_GUID=
# TOAST_TAKEOUT_DINING_OPTION_GUID=
# TOAST_MENU_GROUP_GUID=
